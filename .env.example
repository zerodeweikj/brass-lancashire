# 环境变量示例（本文件可安全提交；真实值不要写在这里，也不要写进 render.yaml）
#
# 部署到 Render 时：
#   - DATABASE_URL / JWT_SECRET 在 Render 控制台的 Environment 里填写（render.yaml 中已标 sync:false，不会进 git）
#   - 本地开发时把真实值填进 .env（已被 .gitignore 忽略，不会提交）
#
# Neon Postgres 连接串（含密码，来自 Neon 控制台，形如：
#   postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require）
DATABASE_URL=

# JWT 签名密钥（生成一段足够随机的字符串，例如：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# 注意：一旦设置就不要随便改，否则已签发的登录 token 会全部失效）
JWT_SECRET=

# 登录 token 有效期（秒），默认 30 天
AUTH_TOKEN_TTL=2592000
